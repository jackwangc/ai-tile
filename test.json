{
    // 使用 IntelliSense 了解相关属性。 
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        // 配置 1：python 调试
        {
            "name": "Python: Debug Ascend Kernel",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false ,// 关键：设置为 false 才能跳进库代码
            "preLaunchTask": "set env", // 先运行 Task 生成 .env
            "envFile": "${workspaceFolder}/.env", // 然后加载这个 .env
        },
        // 配置 2：C++ 附加调试
        {
            "name": "Step 2: Attach C++ (GDB)",
            "type": "cppdbg",
            "request": "attach",
            "program": "/usr/bin/python", // 必须指向你运行脚本的那个 python 路径
            "processId": "${command:pickProcess}", // 运行时会让你选进程
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}


{
    // 需要提前配置下环境变量，增次要增加一个任务
    "version": "2.0.0",
